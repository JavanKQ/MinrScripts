# ==============================================================
# OCEAN PUZZLE - EXIT (3 of 12)
# ==============================================================
# Script type : walk
# Bind to     : 8 floor blocks, one bind each (test server coords):
#               -1847 72 1556, -1846 72 1556, -1845 72 1556,
#               -1844 72 1556, -1843 72 1556, -1842 72 1556,
#               -1841 72 1556, -1840 72 1556
# Map/area    : [FILL IN: map name / room]
# Import      : /script import walk <paste URL>, then click the block
#
# What it does:
#   Rebuilds the wall over the stairway after a player leaves
#   the puzzle area, returning the entrance to normal.
#   First, anyone whose body overlaps a stairway block about to
#   reappear is teleported out, so nobody can be sealed inside:
#   players who solved Room 1 to the top (standing on the Exit floor at -1844 72 1556;
#   landing there fires Exit once more, which is harmless),
#   everyone else back into Room 1 (-1850.5 68 1568.5, in front of the Room 1 note blocks),
#   so nobody caught by someone else's Exit loses progress.
#   A plain teleport at the end catches anyone the first pass
#   missed and sends them into Room 1.
#
# Placement note:
#   Just past the top of the stairway, once the player is back
#   through the entrance.
#
# Map coordinates used inside this script:
#   Stair ceiling : -1846 70 1562 to -1841 70 1565
#   Stair wall    : -1846 69 1565 to -1841 67 1565
#   (must match the Submit script)
#   Safe spots: solved -1843.5 73 1556.5 (standing on -1844 72 1556),
#   not solved -1850.5 68 1568.5 (in front of the note blocks)
#   Search box: -1847 65 1561 to -1840 70 1566
#
# Requires: puzzle1 namespace (reads solved)
# Related scripts: Submit (1), Entrance (2), Reset (4), Note Tune (5), Team Conduit (6), Symbols (7)
# ==============================================================
@using puzzle1
# --- Move anyone out of the blocks about to reappear ---
# Everyone near the stairway (feet within 1 block of it):
@define Region near = Region(-1847, 65, 1561, -1840, 70, 1566, block.getWorld())
@define Double px = 0.0D
@define Double py = 0.0D
@define Double pz = 0.0D
@for Player p in near.getPlayersInside()
@var px = p.getX()
@var py = p.getY()
@var pz = p.getZ()
# Does their body (0.6 wide, 1.8 tall) overlap a refilled block?
@if (px > -1846.3D && px < -1839.7D && py > 68.2D && py < 71.0D && pz > 1561.7D && pz < 1566.3D) || (px > -1846.3D && px < -1839.7D && py > 65.2D && py < 70.0D && pz > 1564.7D && pz < 1566.3D)
@if solved[p]
# Solved Room 1: out at the top of the stairway
@bypass /tp {{p.getName()}} -1843.5 73 1556.5
@else
# Not solved: back down into Room 1
@bypass /tp {{p.getName()}} -1850.5 68 1568.5
@fi
@fi
@done
# --- Fallback, in case the list above didn't work: anyone still
# overlapping a refilled block goes back into Room 1 (one line per region) ---
@bypass /tp @a[x=-1846,y=70,z=1562,dx=5,dy=0,dz=3] -1850.5 68 1568.5
@bypass /tp @a[x=-1846,y=67,z=1565,dx=5,dy=2,dz=0] -1850.5 68 1568.5
# --- Refill the stairway ---
@bypass /fill -1846 70 1562 -1841 70 1565 prismarine_bricks
@bypass /fill -1846 69 1565 -1841 67 1565 prismarine_bricks

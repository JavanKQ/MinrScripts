# ==============================================================
# OCEAN PUZZLE - ENTRANCE (2 of 7)
# ==============================================================
# Script type : walk
# Bind to     : 6 blocks, one bind each (test server coords):
#               -1846 68 1566, -1845 68 1566, -1844 68 1566,
#               -1843 68 1566, -1842 68 1566, -1841 68 1566
#               (triggers as the player drops through the air
#               space above, y69)
# Map/area    : [FILL IN: map name / room]
# Import      : /script import walk <paste URL>, then click the block
#
# What it does:
#   Gives the player a new random answer (10 different notes)
#   each time they enter the puzzle area. Skipped if the
#   player has already solved the puzzle. If the player is on
#   a team (see Team Conduit), every teammate gets the same new
#   song and a message. Teammates who are offline or have
#   joined another team are dropped from the team first, and
#   the rest are told who left.
#
# Placement note:
#   Must be on the checkpoint side of the one-way drop, where
#   players CANNOT step from inside the puzzle area. Stepping
#   on it again would reset their answer.
#
# Requires: puzzle1 namespace (see Submit script header)
# Related scripts: Submit (1), Exit (3), Reset (4), Note Tune (5), Team Conduit (6), Symbols (7)
# ==============================================================
@using puzzle1
@if solved
@return
@fi
@define Int[] pool = list::range(0, 25)
@var pool.shuffle()
@define String[] notes = String[]
@for Int i in list::range(0, 10)
@var notes.append(String(pool[i]))
@done
@define String song = notes.join(",")
@var answer = song
@player &3Oracle: &bThe tides shift... the elders' song is sung anew.
# --- Team check: drop teammates who are offline or on another team ---
@define String me = player.getUniqueId()
@define String stay = me
@define String leftNames = ""
@define Boolean dropped = false
@define Player p = player
@if team != ""
@for String id in team_members.split(",")
@if id != me
@var p = Player(id)
@if p == null
@var dropped = true
@if leftNames != ""
@var leftNames = leftNames + ", "
@fi
@var leftNames = leftNames + "a teammate"
@elseif team[p] != team || !p.isOnline()
@var dropped = true
@if leftNames != ""
@var leftNames = leftNames + ", "
@fi
@var leftNames = leftNames + p.getName()
@else
@var stay = stay + "," + id
@fi
@fi
@done
@if dropped
@if stay == me
@var team = ""
@var team_members = ""
@player &7&o[Note] You and {{leftNames}} are no longer on the same team. You are now playing solo.
@else
@define String newId = team + "~" + "{{system::currentTimeMillis() / 1000L}}"
@for String id in stay.split(",")
@var p = Player(id)
@if p != null
@var team[p] = newId
@var team_members[p] = stay
@var p.sendMessage("§7§o[Note] {{leftNames}} is no longer on your team (went offline or joined another team).")
@fi
@done
@fi
@fi
@fi
# --- End team check ---
@if team == ""
@return
@fi
@for String id in stay.split(",")
@if id != me
@var p = Player(id)
@if p != null
@var answer[p] = song
@var p.sendMessage("§3Oracle: §b{{player.getName()}} was claimed by the deep... the elders have composed a new song for you all.")
@fi
@fi
@done

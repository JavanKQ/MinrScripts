# ==============================================================
# OCEAN PUZZLE - EXIT (3 of 12)
# ==============================================================
# Script type : walk
# Bind to     : 4 blocks, one bind each (the floor of the Room 3
#               doorway):
#               11429 159 10990, 11429 159 10991,
#               11430 159 10990, 11430 159 10991
#               It fires when a player's feet enter the space above
#               them (y160).
# Map/area    : [FILL IN: map name / room]
# Import      : /script import walk <paste URL>, then click the block
#
# What it does:
#   Rebuilds the wall over the stairway after a player leaves
#   the puzzle area, returning the entrance to normal.
#   First, anyone whose body overlaps a stairway block about to
#   reappear is teleported out, so nobody can be sealed inside:
#   players who solved Room 1 to the top (standing on 11445 160 10992),
#   everyone else back into Room 1 (standing on 11448 159 10972, in Room 1),
#   so nobody caught by someone else's Exit loses progress.
#   A plain teleport at the end catches anyone the first pass
#   missed and sends them into Room 1.
#
# Placement note:
#   Just past the top of the stairway, once the player is back
#   through the entrance.
#
# Map coordinates used inside this script:
#   Stairway (3 regions):
#     11438 163 10979 to 11449 163 10981
#     11442 162 10978 to 11445 162 10978
#     11442 162 10977 to 11445 161 10977
#   all prismarine bricks, except the stairs:
#     11442 163 10980 to 11445 163 10980 (prismarine stairs,
#     facing north)
#   (must match the Submit script)
#   Safe spots: solved 11445.5 161 10992.5 (standing on 11445 160 10992),
#   not solved 11448.5 160 10972.5 (standing on 11448 159 10972)
#   Search box: 11437 159 10976 to 11450 163 10982
#
# Requires: puzzle1 namespace (reads solved)
# Related scripts: Submit (1), Entrance (2), Reset (4), Note Tune (5), Team Conduit (6), Symbols (7)
# ==============================================================
@using puzzle1
# --- Move anyone out of the blocks about to reappear ---
# Everyone near the stairway (feet within 1 block of it):
@define Region near = Region(11437, 159, 10976, 11450, 163, 10982, block.getWorld())
@define Double px = 0.0D
@define Double py = 0.0D
@define Double pz = 0.0D
@for Player p in near.getPlayersInside()
@var px = p.getX()
@var py = p.getY()
@var pz = p.getZ()
# Does their body (0.6 wide, 1.8 tall) overlap a refilled block?
@if (px > 11437.7D && px < 11450.3D && py > 161.2D && py < 164.0D && pz > 10978.7D && pz < 10982.3D) || (px > 11441.7D && px < 11446.3D && py > 160.2D && py < 163.0D && pz > 10977.7D && pz < 10979.3D) || (px > 11441.7D && px < 11446.3D && py > 159.2D && py < 163.0D && pz > 10976.7D && pz < 10978.3D)
@if solved[p]
# Solved Room 1: out at the top of the stairway
@bypass /tp {{p.getName()}} 11445.5 161 10992.5
@else
# Not solved: back down into Room 1
@bypass /tp {{p.getName()}} 11448.5 160 10972.5
@fi
@fi
@done
# --- Fallback, in case the list above didn't work: anyone still
# overlapping a refilled block goes back into Room 1 (one line per region) ---
@bypass /tp @a[x=11438,y=163,z=10979,dx=11,dy=0,dz=2] 11448.5 160 10972.5
@bypass /tp @a[x=11442,y=162,z=10978,dx=3,dy=0,dz=0] 11448.5 160 10972.5
@bypass /tp @a[x=11442,y=161,z=10977,dx=3,dy=1,dz=0] 11448.5 160 10972.5
# --- Refill the stairway ---
@bypass /fill 11438 163 10979 11449 163 10981 prismarine_bricks
@bypass /fill 11442 162 10978 11445 162 10978 prismarine_bricks
@bypass /fill 11442 162 10977 11445 161 10977 prismarine_bricks
@bypass /fill 11442 163 10980 11445 163 10980 prismarine_stairs[facing=north]
